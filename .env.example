# Example environment configuration for ai-agent-chatbot backend
# Copy this file to .env and fill in real values.

# OpenRouter API key for language model access
OPENROUTER_API_KEY=your-openrouter-api-key-here

# Groq API key (alternative LLM provider)
GROQ_API_KEY=your-groq-api-key-here

# Slack bot token (if integrating with Slack)
SLACK_BOT_TOKEN=your-slack-bot-token-here

# GitHub OAuth credentials (optional, disabled in this repo but kept for reference)
GITHUB_OAUTH_CLIENT_ID=your-github-client-id-here
GITHUB_OAUTH_CLIENT_SECRET=your-github-client-secret-here

# OpenWeather API key (used for weather lookups)
OPENWEATHER_API_KEY=your-openweather-api-key-here

# Frontend URL – where the UI is served
FRONTEND_URL=http://localhost:5173

# Backend URL – where this API is reachable
BACKEND_URL=http://127.0.0.1:8000

# Environment (development or production)
ENVIRONMENT=development

# Server port (defaults to 8000 if not set)
PORT=8000

